<?xml version="1.0" encoding="UTF-8"?>


<templates xml:space="preserve">

    <t t-name="tindahan_pos.PosWidget" owl="1">
        <div class="tindahan-pos-widget">

            <!-- Search -->
            <div class="pos-product-search mb-3">
                <input
                    type="text"
                    class="form-control"
                    placeholder="Search product..."
                    t-att-value="state.search"
                    t-on-input="onSearchInput"
                />
            </div>

            <!-- Variant Category Tabs -->
            <div
                t-if="state.products &amp;&amp; state.products.length"
                class="pos-category-tabs"
            >
                <button
                    type="button"
                    t-att-class="state.selectedVariant === 'all'
                        ? 'pos-category-tab active'
                        : 'pos-category-tab'"
                    t-on-click="() => this.selectVariant('all')"
                >
                    All
                </button>

                <t
                    t-foreach="state.variants || []"
                    t-as="variant"
                    t-key="variant"
                >
                    <button
                        type="button"
                        t-att-class="state.selectedVariant === variant
                            ? 'pos-category-tab active'
                            : 'pos-category-tab'"
                        t-on-click="() => this.selectVariant(variant)"
                    >
                        <t t-esc="variant"/>
                    </button>
                </t>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="text-center p-4">
                Loading products...
            </div>

            <!-- Empty State -->
            <div
                t-elif="!filteredProducts.length"
                class="text-center p-4"
            >
                No products found.
            </div>

            <!-- Product Grid -->
            <div t-else="" class="pos-product-container">
                <div class="pos-product-grid">

                    <t
                        t-foreach="filteredProducts"
                        t-as="product"
                        t-key="product.id"
                    >
                        <button
                            type="button"
                            class="pos-product-card"
                            t-on-click="() => this.addProduct(product)"
                        >
                            <span class="pos-product-name">
                                <t t-esc="product.name"/>
                            </span>

                            <span
                                t-if="product.variant"
                                class="pos-product-description"
                            >
                                <t t-esc="product.variant"/>
                            </span>

                            <span class="pos-product-price">
                                ₱<t t-esc="(product.price || 0).toFixed(2)"/>
                            </span>
                        </button>
                    </t>

                </div>
            </div>

        </div>
    </t>

</templates>
