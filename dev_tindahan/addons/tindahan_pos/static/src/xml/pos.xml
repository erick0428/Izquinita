<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="tindahan_pos.POSScreen">

        <div class="tindahan-pos">

            <!-- LEFT -->
            <div class="pos-products">

                <div class="pos-header">
                    <h1>Products</h1>
                </div>

                <div class="pos-search">
                    <input
                        type="text"
                        placeholder="🔎 Search product..."
                        t-model="state.search"
                    />
                </div>

                <div class="category-tabs">

                    <t
                        t-foreach="state.variants"
                        t-as="variant"
                        t-key="variant.id"
                    >

                        <button
                            t-att-class="{
                                'tab-button': true,
                                'active': state.activeVariant === variant.id
                            }"
                            t-on-click="
                                () => this.state.activeVariant = variant.id
                            "
                        >
                            <t t-esc="variant.name"/>
                        </button>

                    </t>

                </div>

                <t
                    t-set="active"
                    t-value="state.variants.find(v => v.id === state.activeVariant)"
                />

                <div class="product-grid">

                    <t t-if="active">

                        <t
                            t-foreach="active.products.filter(p => !state.search || p.name.toLowerCase().includes(state.search.toLowerCase()))"
                            t-as="product"
                            t-key="product.id"
                        >

                            <button
                                class="product-card"
                                t-on-click="() => this.addProduct(product)"
                            >

                                <div
                                    class="product-name"
                                    t-esc="product.name"
                                />

                                <div class="product-price">
                                    <t t-esc="this.formatPrice(product.srp)"/>
                                </div>

                            </button>

                        </t>

                    </t>

                </div>

            </div>


            <!-- RIGHT -->
            <div class="pos-order">

                <div class="order-header">

                    <h1>Current Order</h1>

                    <div class="session-bar">

                        <t t-if="!state.session">

                            <button t-on-click="openSession">
                                OPEN POS
                            </button>

                        </t>

                        <t t-else="">

                            <span>
                                Session:
                                <t t-esc="state.session.name"/>
                            </span>

                            <button
                                type="button"
                                class="close-pos-button"
                                t-on-click="openCloseDialog"
                            >
                                CLOSE POS
                            </button>

                        </t>

                    </div>

                    <div class="customer-section">

                        <input
                            type="text"
                            placeholder="Customer Name"
                            t-model="state.customer_name"
                        />

                    </div>

                </div>


                <!-- CART -->
                <div class="cart">

                    <t t-if="state.cart.length">

                        <t
                            t-foreach="state.cart"
                            t-as="line"
                            t-key="line.product_id"
                        >

                            <div class="cart-line">

                                <div class="cart-product">

                                    <div class="cart-name">
                                        <t t-esc="line.name"/>
                                    </div>

                                    <div
                                        class="cart-desc"
                                        t-if="line.description"
                                    >
                                        <t t-esc="line.description"/>
                                    </div>

                                    <div class="cart-price">
                                        <t t-esc="this.formatPrice(line.price)"/>
                                    </div>

                                </div>


                                <div class="quantity-controls">

                                    <button
                                        class="quantity-button"
                                        t-on-click="() => this.decreaseQuantity(line)"
                                    >
                                        −
                                    </button>

                                    <span t-esc="line.quantity"/>

                                    <button
                                        class="quantity-button"
                                        t-on-click="() => this.increaseQuantity(line)"
                                    >
                                        +
                                    </button>

                                </div>


                                <div class="line-subtotal">

                                    <t
                                        t-esc="
                                            this.formatPrice(
                                                line.price * line.quantity
                                            )
                                        "
                                    />

                                </div>


                                <button
                                    class="remove-button"
                                    t-on-click="() => this.removeProduct(line)"
                                >
                                    ×
                                </button>

                            </div>

                        </t>

                    </t>

                    <t t-else="">

                        <div class="empty-cart">

                            <h3>No products</h3>

                            <p>
                                Select a product to add it to the order.
                            </p>

                        </div>

                    </t>

                </div>


                <!-- FOOTER -->
                <div class="order-footer">

                    <div class="summary-row">

                        <div>
                            <span>Total</span>
                            <strong>
                                <t t-esc="this.formatPrice(state.total)"/>
                            </strong>
                        </div>

                        <div>
                            <span>Cash</span>
                            <strong>
                                <t t-esc="this.formatPrice(state.cash || 0)"/>
                            </strong>
                        </div>

                        <div>
                            <span>Change</span>
                            <strong>
                                <t t-esc="this.formatPrice(state.change)"/>
                            </strong>
                        </div>

                    </div>


                    <!-- KEYPAD -->
                    <div class="keypad">

                        <t
                            t-foreach="['7','8','9','4','5','6','1','2','3','0','.','⌫']"
                            t-as="key"
                            t-key="key"
                        >

                            <button
                                class="key"
                                t-on-click="() => this.pressKey(key)"
                            >
                                <t t-esc="key"/>
                            </button>

                        </t>

                    </div>


                    <div class="order-actions">

                        <button
                            class="clear-button"
                            t-on-click="clearCart"
                        >
                            CLEAR
                        </button>

                        <button
                            class="pay-button"
                            t-on-click="payOrder"
                        >
                            PAY
                        </button>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- CLOSE SESSION MODAL -->
            <!-- ================================================= -->

            <t t-if="state.showCloseDialog">

                <div class="pos-close-overlay">

                    <div class="pos-close-modal">

                        <h2>Close POS Session</h2>

                        <div class="cash-row">

                            <label>Opening Cash</label>

                            <strong>
                                <t t-esc="
                                    this.formatPrice(
                                        state.session.opening_cash
                                    )
                                "/>
                            </strong>

                        </div>

                        <div class="cash-row">

                            <label>Total Sales</label>

                            <strong>
                                <t t-esc="
                                    this.formatPrice(
                                        state.session.total_sales
                                    )
                                "/>
                            </strong>

                        </div>

                        <div class="cash-row">

                            <label>Expected Closing Cash</label>

                            <strong>
                                <t t-esc="
                                    this.formatPrice(
                                        (state.session.opening_cash || 0) +
                                        (state.session.total_sales || 0)
                                    )
                                "/>
                            </strong>

                        </div>

                        <div class="cash-input">

                            <label>Actual Cash Counted</label>

                            <input
                                type="number"
                                step="0.01"
                                t-model="state.closingCashInput"
                                placeholder="Enter actual cash"
                            />

                        </div>

                        <div class="modal-actions">

                            <button
                                type="button"
                                t-on-click="confirmCloseSession"
                            >
                                CLOSE SESSION
                            </button>

                            <button
                                type="button"
                                t-on-click="() => this.state.showCloseDialog = false"
                            >
                                CANCEL
                            </button>

                        </div>

                    </div>

                </div>

            </t>

            <!-- Show report -->

            <t t-if="state.showReport">

                <div class="pos-close-overlay">

                    <div class="pos-close-modal">

                        <h2>POS Closing Report</h2>

                        <div class="cash-row">
                            <label>Session</label>
                            <strong>
                                <t t-esc="state.report.name"/>
                            </strong>
                        </div>

                        <div class="cash-row">
                            <label>Total Orders</label>
                            <strong>
                                <t t-esc="state.report.total_orders"/>
                            </strong>
                        </div>

                        <div class="cash-row">
                            <label>Opening Cash</label>
                            <strong>
                                <t t-esc="
                                    this.formatPrice(
                                        state.report.opening_cash
                                    )
                                "/>
                            </strong>
                        </div>

                        <div class="cash-row">
                            <label>Total Sales</label>
                            <strong>
                                <t t-esc="
                                    this.formatPrice(
                                        state.report.total_sales
                                    )
                                "/>
                        </strong>
                        </div>

                        <div class="cash-row">
                            <label>Expected Closing Cash</label>
                            <strong>
                                <t t-esc="
                                    this.formatPrice(
                                        state.report.expected_cash
                                    )
                                "/>
                            </strong>
                        </div>

                        <div class="cash-row">
                            <label>Actual Cash Counted</label>
                            <strong>
                                <t t-esc="
                                    this.formatPrice(
                                        state.report.closing_input
                                    )
                                "/>
                            </strong>
                        </div>

                        <div class="cash-row">
                            <label>Difference</label>
                            <strong>
                                <t t-esc="
                                    this.formatPrice(
                                        state.report.difference
                                    )
                                "/>
                            </strong>
                        </div>

                        <div class="modal-actions">

                            <button
                                type="button"
                                t-on-click="closeReport"
                            >
                                CLOSE
                            </button>

                        </div>

                    </div>

                </div>

            </t>

            <!-- ================================================= -->
            <!-- RECEIPT -->
            <!-- ================================================= -->

            <t t-if="state.showReceipt">

                <div class="receipt-print">

                    <div class="receipt-header">
                        <h2>TINDAHAN POS</h2>
                        <p>Official Receipt</p>
                    </div>

                    <div class="receipt-info">
                        <div>
                            <span>Order:</span>
                            <strong>
                                <t t-esc="state.receipt.order_name"/>
                            </strong>
                        </div>

                        <div>
                            <span>Customer:</span>
                            <strong>
                                <t t-esc="state.receipt.customer_name || 'Walk-in Customer'"/>
                            </strong>
                        </div>

                        <div>
                            <span>Date:</span>
                            <strong>
                                <t t-esc="state.receipt.date"/>
                            </strong>
                        </div>
                    </div>

                    <div class="receipt-items">

                        <t
                            t-foreach="state.receipt.lines"
                            t-as="line"
                            t-key="line.product_id"
                        >

                            <div class="receipt-line">

                                <div class="receipt-product">
                                    <span>
                                        <t t-esc="line.name"/>
                                    </span>

                                    <small>
                                        <t t-esc="line.quantity"/>
                                        ×
                                        <t t-esc="this.formatPrice(line.price)"/>
                                    </small>
                                </div>

                                <strong>
                                    <t
                                        t-esc="
                                            this.formatPrice(
                                                line.price * line.quantity
                                            )
                                        "
                                    />
                                </strong>

                            </div>

                        </t>

                    </div>

                    <div class="receipt-total">

                        <div>
                            <span>Total</span>
                            <strong>
                                <t t-esc="this.formatPrice(state.receipt.total)"/>
                            </strong>
                        </div>

                        <div>
                            <span>Cash</span>
                            <strong>
                                <t t-esc="this.formatPrice(state.receipt.cash)"/>
                            </strong>
                        </div>

                        <div>
                            <span>Change</span>
                            <strong>
                                <t t-esc="this.formatPrice(state.receipt.change)"/>
                            </strong>
                        </div>

                    </div>

                    <div class="receipt-footer">
                        <p>Thank you for your purchase!</p>
                    </div>

                </div>

            </t>

            

        </div>

    </t>

</templates>