<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- POS List View -->
    <record id="view_tindahan_pos_pos_list" model="ir.ui.view">
        <field name="name">tindahan_pos.pos.list</field>
        <field name="model">tindahan_pos.pos</field>
        <field name="arch" type="xml">
            <list string="POS Transactions">
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="subtotal"/>
            </list>
        </field>
    </record>


    <!-- POS Form View -->
    <record id="view_tindahan_pos_pos_form" model="ir.ui.view">
        <field name="name">tindahan_pos.pos.form</field>
        <field name="model">tindahan_pos.pos</field>
        <field name="arch" type="xml">

            <form string="POS">

                <sheet>

                    <!-- MAIN POS CONTAINER -->
                    <div class="o_pos_screen">

                        <!-- LEFT SIDE - 50% -->
                        <div class="o_pos_products">

                            <h2>Products</h2>

                            <!-- RICE MEALS -->
                            <div class="o_pos_category">
                                <h3>Rice Meals</h3>

                                <div class="o_pos_product_buttons">
                                    <button type="button"
                                            class="btn btn-primary">
                                        Chicken Rice
                                    </button>

                                    <button type="button"
                                            class="btn btn-primary">
                                        Pork Rice
                                    </button>

                                    <button type="button"
                                            class="btn btn-primary">
                                        Bangus Rice
                                    </button>
                                </div>
                            </div>


                            <!-- SILOG MEALS -->
                            <div class="o_pos_category">
                                <h3>Silog Meals</h3>

                                <div class="o_pos_product_buttons">
                                    <button type="button"
                                            class="btn btn-success">
                                        Tapsilog
                                    </button>

                                    <button type="button"
                                            class="btn btn-success">
                                        Longsilog
                                    </button>

                                    <button type="button"
                                            class="btn btn-success">
                                        Hotsilog
                                    </button>
                                </div>
                            </div>


                            <!-- A LA CARTE -->
                            <div class="o_pos_category">
                                <h3>A La Carte</h3>

                                <div class="o_pos_product_buttons">
                                    <button type="button"
                                            class="btn btn-warning">
                                        Fried Egg
                                    </button>

                                    <button type="button"
                                            class="btn btn-warning">
                                        Fries
                                    </button>

                                    <button type="button"
                                            class="btn btn-warning">
                                        Extra Rice
                                    </button>
                                </div>
                            </div>

                        </div>


                        <!-- RIGHT SIDE - 50% -->
                        <div class="o_pos_order">

                            <h2>Current Order</h2>

                            <group>
                                <field name="name"/>
                                <field name="product_id"/>
                                <field name="quantity"/>
                            </group>

                            <separator string="Order Details"/>

                            <group>
                                <field name="price" readonly="1"/>
                                <field name="subtotal" readonly="1"/>
                            </group>

                            <div class="o_pos_total">
                                <h2>
                                    Total:
                                    <field name="subtotal"
                                           readonly="1"/>
                                </h2>
                            </div>

                            <button type="object"
                                    name="action_pay"
                                    string="PAY"
                                    class="btn btn-primary btn-lg"/>

                        </div>

                    </div>

                </sheet>

            </form>

        </field>
    </record>


    <!-- POS Action -->
    <record id="action_pos" model="ir.actions.act_window">
        <field name="name">POS</field>
        <field name="res_model">tindahan_pos.pos</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
:::

Then add CSS to make the two sides actually **50/50**.

### `pos.css`

:::writing{variant="document" id="31694"}
```css
.o_pos_screen {
    display: flex;
    width: 100%;
    min-height: 700px;
}

/* LEFT 50% */
.o_pos_products {
    width: 50%;
    padding: 20px;
    background-color: #f5f5f5;
    border-right: 2px solid #ddd;
}

/* RIGHT 50% */
.o_pos_order {
    width: 50%;
    padding: 20px;
    background-color: white;
}

/* CATEGORY */
.o_pos_category {
    margin-bottom: 30px;
}

.o_pos_category h3 {
    margin-bottom: 15px;
    font-size: 22px;
}

/* PRODUCT BUTTONS */
.o_pos_product_buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.o_pos_product_buttons button {
    min-width: 140px;
    min-height: 70px;
    font-size: 16px;
}

/* TOTAL */
.o_pos_total {
    margin-top: 30px;
    padding: 20px;
    background-color: #eeeeee;
    text-align: right;
}
