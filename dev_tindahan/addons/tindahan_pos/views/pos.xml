<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- POS LIST VIEW -->
    <!-- ===================================================== -->

    <record id="view_tindahan_pos_pos_list" model="ir.ui.view">

        <field name="name">tindahan_pos.pos.list</field>

        <field name="model">tindahan_pos.pos</field>

        <field name="arch" type="xml">

            <list string="POS Transactions">

                <field name="name"/>
                <field name="customer_name"/>
                <field name="cash"/>
                <field name="change"/>
                <field name="total"/>
                <field name="kitchen_status"/>
                <field name="payment_status"/>
                <field name="session_id"/>

            </list>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- POS FORM VIEW -->
    <!-- ===================================================== -->

    <record id="view_tindahan_pos_pos_form" model="ir.ui.view">

        <field name="name">tindahan_pos.pos.form</field>

        <field name="model">tindahan_pos.pos</field>

        <field name="arch" type="xml">

            <form string="POS Transaction">
                <header>

                    <button
                        name="action_print_receipt"
                        type="object"
                        string="Print Receipt"
                        class="btn-primary"
                    />

                </header>
                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="customer_name"/>
                        <field name="cash"/>
                        <field name="change"/>
                        <field name="kitchen_status"/>
                        <field name="payment_status"/>
                    </group>


                    <field name="line_ids">

                        <list editable="bottom">

                            <field name="product_id"/>
                            <field name="product_description"/>
                            <field name="variant_id"/>
                            <field name="quantity"/>
                            <field name="price"/>
                            <field name="subtotal"/>

                        </list>

                    </field>


                    <group>

                        <field name="total"
                               readonly="1"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- POS TRANSACTION ACTION -->
    <!-- ===================================================== -->

    <record id="action_pos" model="ir.actions.act_window">

        <field name="name">POS Transactions</field>

        <field name="res_model">tindahan_pos.pos</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ===================================================== -->
    <!-- OWL POS CLIENT ACTION -->
    <!-- ===================================================== -->

    <record id="action_pos_screen" model="ir.actions.client">

        <field name="name">POS</field>

        <field name="tag">tindahan_pos.pos_screen</field>



    </record>

    <record id="action_pos_screen1" model="ir.actions.client">
        <field name="name">POS</field>
        <field name="tag">tindahan_pos.pos_screen1</field>
    </record>



</odoo>
