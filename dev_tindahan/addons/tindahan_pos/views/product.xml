<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action -->
    <record id="action_product" model="ir.actions.act_window">
        <field name="name">Product</field>
        <field name="res_model">tindahan_pos.product</field>
        <field name="view_mode">list,form</field> <!-- 'tree' changed to 'list' -->
    </record>

    <!-- List View -->
    <record id="view_product_list" model="ir.ui.view">
        <field name="name">product.list</field>
        <field name="model">tindahan_pos.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="variant_id"/>
                <field name="cost"/>
                <field name="srp"/>
                
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_product_form" model="ir.ui.view">
        <field name="name">product.form</field>
        <field name="model">tindahan_pos.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description"/>
                        <field name="image"/>
                        <field name="variant_id"/>
                        <field name="cost"/>
                        <field name="srp"/>                        
                        
					</group>
					         
           
                </sheet>
            </form>
        </field>
    </record>
</odoo>