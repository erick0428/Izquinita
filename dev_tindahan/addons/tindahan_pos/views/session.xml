<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action -->
    <record id="action_session" model="ir.actions.act_window">
        <field name="name">Session</field>
        <field name="res_model">tindahan_pos.session</field>
        <field name="view_mode">list,form</field> <!-- 'tree' changed to 'list' -->
    </record>

    <!-- List View -->
    <record id="view_session_list" model="ir.ui.view">
        <field name="name">session.list</field>
        <field name="model">tindahan_pos.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="closing_input"/>
                <field name="state"/>
                <field name="opening_cash"/>
                <field name="closing_cash"/>
                <field name="total_sales"/>
                
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_session_form" model="ir.ui.view">
        <field name="name">session.form</field>
        <field name="model">tindahan_pos.session</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="closing_input"/>
                        <field name="state"/>
                        <field name="opening_cash"/>
                        <field name="closing_cash"/>
                        <field name="total_sales"/>
                        
					</group>
					         
           
                </sheet>
            </form>
        </field>
    </record>
</odoo>