<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action -->
    <record id="action_sales" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">tindahan.sales</field>
        <field name="view_mode">list,form</field> <!-- 'tree' changed to 'list' -->
    </record>

    <!-- List View -->
    <record id="view_sales_list" model="ir.ui.view">
        <field name="name">sales.list</field>
        <field name="model">tindahan.sales</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="amount"/>
                <field name="date"/>
                
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sales_form" model="ir.ui.view">
        <field name="name">sales.form</field>
        <field name="model">tindahan.sales</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="amount" />
                        <field name="date" />
                        
                        
					</group>
					         
           
                </sheet>
            </form>
        </field>
    </record>
</odoo>