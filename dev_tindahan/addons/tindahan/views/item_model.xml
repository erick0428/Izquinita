<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action -->
    <record id="action_item_model" model="ir.actions.act_window">
        <field name="name">Item Model</field>
        <field name="res_model">tindahan.item_model</field>
        <field name="view_mode">list,form</field> <!-- 'tree' changed to 'list' -->
    </record>

    <!-- List View -->
    <record id="view_item_model_list" model="ir.ui.view">
        <field name="name">item_model.list</field>
        <field name="model">tindahan.item_model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_item_model_form" model="ir.ui.view">
        <field name="name">item_model.form</field>
        <field name="model">tindahan.item_model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="category_id" />
                        
                        
					</group>
					         
           
                </sheet>
            </form>
        </field>
    </record>
</odoo>